# ═══════════════════════════════════════════════════════════
# FRENVI Admin UI  —  separate from the Backend API
# ═══════════════════════════════════════════════════════════
#
# Admin UI (this Vite app)
#   Dev:  npm run dev  →  http://localhost:5173/admin/
#   Prod: served at    →  https://api.frenvi.co/admin   (or your ADMIN_PUBLIC_URL)
#
# Backend API (Node server — different process / origin)
#   Local:  http://localhost:5000
#   Live:   https://api.frenvi.co
#
# Never point VITE_BACKEND_URL at the Admin UI URL.
# ═══════════════════════════════════════════════════════════

# Port for `npm run dev` (Admin UI only)
VITE_ADMIN_DEV_PORT=5173

# Public Admin UI link (shown in the header / docs)
VITE_ADMIN_PUBLIC_URL=http://localhost:5173/admin/

# Backend API origin — NO trailing /api
# Live backend (default):
VITE_BACKEND_URL=https://api.frenvi.co
# Local backend (optional):
# VITE_BACKEND_URL=http://localhost:5000

